# 允许接入的本地 Git 仓库父目录（Windows 下多个路径用分号 ; 分隔）
IMPACT_REPOSITORY_ROOTS=D:\WorkSpace\Impact-Trace-LLM\data\local;D:\Project

# 可选：AI 模型预设配置（也可直接在网页右上角「AI 模型设置」中可视化填写和保存）
# 支持 openai_compatible（DeepSeek / OpenAI / 硅基流动 / 通义千问 / Moonshot / Ollama）以及 gemini、anthropic
IMPACT_LLM_PROVIDER=openai_compatible
IMPACT_LLM_BASE_URL=https://api.deepseek.com/v1
IMPACT_LLM_API_KEY=
IMPACT_LLM_MODEL=deepseek-chat
